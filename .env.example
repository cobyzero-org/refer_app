# Copia a .env y ajusta según tu entorno
# .env NO se commiteea — este archivo sí.
# ENV define el entorno activo: dev | prod
# Todo deriva de la BASE_URL del entorno activo -> /api, /cart, /orders

ENV=dev

# Desarrollo (local)
DEV_BASE_URL=http://127.0.0.1:3000
DEV_BASE_URL_ANDROID=http://10.0.2.2:3000

# Producción
PROD_BASE_URL=https://refer-api.cobyzero.com
PROD_BASE_URL_ANDROID=https://refer-api.cobyzero.com

STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_MERCHANT_IDENTIFIER=merchant.com.example.refer_app
